{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/geo.mjs:*)",
      "Bash(node scripts/recipe.mjs:*)",
      "Bash(node scripts/preview.mjs:*)",
      "Read(./.ps-work/**)",
      "Write(./.ps-work/**)",
      "Read(./.ps-state.json)",
      "Write(./.ps-state.json)",
      "Edit(./.ps-state.json)",
      "Read(./.ps-perfil.json)",
      "Write(./.ps-perfil.json)",
      "Edit(./.ps-perfil.json)"
    ],
    "deny": [
      "Read(./**/*.psd)",
      "Read(./**/*.psb)",
      "Read(./assets/raw/**)",
      "Read(./exports/**)",
      "mcp__photoshop__get_layers",
      "mcp__photoshop__get_layer_image"
    ],
    "ask": [
      "mcp__photoshop__get_document_image",
      "mcp__photoshop__generate_image",
      "mcp__photoshop__generative_fill",
      "mcp__photoshop__harmonize_layer"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-handoff.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
