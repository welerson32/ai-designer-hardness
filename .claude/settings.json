{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Designer",
  "enabledMcpjsonServers": ["photoshop", "photoshop-bp"],
  "permissions": {
    "allow": [
      "mcp__photoshop",
      "mcp__photoshop-bp",
      "Bash(node scripts/geo.mjs:*)",
      "Bash(node scripts/recipe.mjs:*)",
      "Bash(node scripts/preview.mjs:*)",
      "Bash(node scripts/exportar.mjs:*)",
      "Bash(node scripts/pauta.mjs:*)",
      "Bash(node scripts/cliente.mjs:*)",
      "Bash(node scripts/setup/doctor.mjs:*)",
      "Bash(node scripts/setup/install.mjs:*)",
      "Read(./workspace/**)",
      "Write(./workspace/**)",
      "Edit(./workspace/**)"
    ],
    "deny": [
      "Read(./**/*.psd)",
      "Read(./**/*.psb)",
      "Read(./assets/raw/**)",
      "Read(./exports/**)",
      "mcp__photoshop__get_layers",
      "mcp__photoshop__get_layer_image"
    ],
    "ask": [
      "mcp__photoshop__get_document_image",
      "mcp__photoshop__generate_image",
      "mcp__photoshop__generative_fill",
      "mcp__photoshop__harmonize_layer",
      "mcp__photoshop__save_document"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v node >/dev/null 2>&1; then node \"${CLAUDE_PROJECT_DIR}/scripts/setup/doctor.mjs\" --hook; else echo '# Checagem do ambiente: Node ausente. Acione a skill ps-setup (instalar Node) antes de qualquer trabalho.'; fi",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-handoff.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
