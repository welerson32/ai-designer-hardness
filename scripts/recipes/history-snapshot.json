{
  "description": "Cria snapshot do histórico do documento ativo. Inserido automaticamente no início de cada lote (rollback = revert-snapshot).",
  "server": "photoshop-bp",
  "params": { "name": "string" },
  "commands": [
    {
      "_obj": "make",
      "_target": [ { "_ref": "snapshotClass" } ],
      "from": { "_ref": "historyState", "_property": "currentHistoryState" },
      "name": "{{name}}",
      "using": { "_enum": "historyState", "_value": "fullDocument" },
      "_isCommand": true
    }
  ],
  "returns": "descriptor vazio",
  "validated": true
}
